{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug nginx kitchen-sink config (devcontainer)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/opt/nginx/sbin/nginx",
      "args": [
        "-p",
        "${workspaceFolder}",
        "-c",
        "${workspaceFolder}/examples/kitchen-sink.conf",
        "-g",
        "daemon off;"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "stopAtEntry": false,
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug nginx kitchen-sink config (docker compose)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/workspace/.nginx-debug/sbin/nginx",
      "args": [
        "-p",
        "/workspace",
        "-c",
        "/workspace/examples/kitchen-sink.conf",
        "-g",
        "daemon off;"
      ],
      "cwd": "/workspace",
      "MIMode": "gdb",
      "preLaunchTask": "docker-debug-build",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "compose",
          "run",
          "--rm",
          "--service-ports",
          "-T",
          "dev",
          "sh",
          "-lc"
        ],
        "debuggerPath": "/usr/bin/gdb",
        "pipeCwd": "${workspaceFolder}"
      },
      "sourceFileMap": {
        "/workspace": "${workspaceFolder}"
      },
      "externalConsole": false,
      "stopAtEntry": false,
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
